# 生产环境变量模板：复制为 .env 后填入真实值，.env 不进版本库也不进镜像。

# 对外域名（不含协议），Caddy 用它申请证书
YUJI_DOMAIN=
# 站点来源（含协议），写入后端 CORS 白名单，例如 https://yuji.example.com
PUBLIC_ORIGIN=

# PostgreSQL 密码
POSTGRES_PASSWORD=
# JWT 签名密钥，至少 32 个 UTF-8 字节
JWT_SIGNING_KEY=

# MiniMax 对话模型密钥
AI_API_KEY=
# MiniMax 向量模型密钥与 GroupId
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_GROUP_ID=

# --- 托管平台部署（Render 等）追加项 ---
# 以下变量在 docker-compose 单机部署时无需设置，由 compose 固定注入；
# 在托管平台上要手工填到服务的环境变量面板，键名用双下划线表示配置层级。
#
# ASPNETCORE_ENVIRONMENT=Production
# ConnectionStrings__Default   Npgsql 关键字格式，不接受 postgresql:// URI 形式，例如
#                              Host=<host>;Port=5432;Database=<db>;Username=<user>;Password=<pwd>
#                              本机连云库需追加 SSL Mode=Require;Trust Server Certificate=true
# Https__Redirect=false        平台已终止 TLS，容器内再跳转会造成重定向循环
# Cors__AllowedOrigins__0      平台分配的站点来源，例如 https://<service>.onrender.com
#                              （此场景下 YUJI_DOMAIN 不使用，它只服务于 Caddy 自动签证书）
# Proxy__KnownNetworks__0      可信反代网段（CIDR）。默认只信任 compose 内网 172.16.0.0/12，
#                              托管平台入口代理不在该段内，不设置会导致 X-Forwarded-* 被丢弃：
#                              登录限流按容器内网地址计数，多个测试者互相挤掉登录。
# DemoData__Enabled            公网暴露时务必评估：demo 账号弱密码 + AI 端点无节流 = 额度可被刷空
# Storage__Provider            Local 依赖持久磁盘；无持久盘的免费档会在重启后丢附件，需改用 COS
